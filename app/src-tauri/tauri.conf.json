{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "con-vert",
  "version": "0.3.0",
  "identifier": "app.convert.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "con/vert settings",
        "theme": "Dark",
        "width": 460,
        "height": 560,
        "resizable": false,
        "visible": false,
        "center": true
      },
      {
        "label": "ring",
        "url": "index.html#ring",
        "width": 384,
        "height": 384,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "shadow": false,
        "resizable": false,
        "dragDropEnabled": false,
        "title": "con/vert menu"
      },
      {
        "label": "toast",
        "url": "index.html#toast",
        "width": 340,
        "height": 156,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "shadow": false,
        "resizable": false,
        "dragDropEnabled": false,
        "title": "con/vert progress"
      },
      {
        "label": "editor",
        "url": "index.html#editor",
        "title": "con/vert",
        "theme": "Dark",
        "width": 1040,
        "height": 740,
        "minWidth": 760,
        "minHeight": 540,
        "visible": false,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "con/vert",
    "copyright": "© 2026 con/vert, open source (MIT), built on File Beaver by DEVIOUSDEV101",
    "licenseFile": "installer-license.txt",
    "category": "Utility",
    "shortDescription": "Drag a file, tap Shift, convert or edit it, audio included.",
    "longDescription": "con/vert adds a radial menu to file drags on Windows: tap Shift while dragging to convert images, PDFs, audio and video, read tempo and key, compress, crop, annotate, redact and more. Works offline. Open source (MIT), built on File Beaver by DEVIOUSDEV101.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/ffmpeg"],
    "resources": {
      "../../THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt",
      "../../licensing/ffmpeg-LICENSE.txt": "ffmpeg-LICENSE.txt"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh",
        "installerIcon": "icons/icon.ico"
      },
      "signCommand": {
        "cmd": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "./sign.ps1",
          "%1"
        ]
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY0OUE1OURERUE5MTI5MTkKUldRWktaSHEzVm1hOUFTTFNiaUpUTXFJMnVWMFc1YkpOdDBydzd4ZWFnOWR3WnFZQzFvSjNab04K",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "mainBinaryName": "con-vert"
}